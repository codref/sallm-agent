# Copy to .env and fill in. Never commit .env.
#
# Gmail: enable 2FA, create an App Password, use that as IMAP_PASSWORD.
#   IMAP_HOST=imap.gmail.com
#   IMAP_PORT=993
# Fastmail / other hosts: use their published IMAP settings.

IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=replace-me
IMAP_SSL=true

# Default mailbox for search/fetch when the model omits --folder
IMAP_FOLDER=INBOX

# Observability (optional — agent defaults match these if unset)
# Requires: docker compose up -d  (Tempo :4318, Prometheus scrapes :9464)
# SALLM_OTLP=http://localhost:4318
# SALLM_METRICS_PORT=9464
