# Optional overrides for the linux_history example.
# History works without this file (defaults: HISTFILE, then ~/.zsh_history, then ~/.bash_history).

# HISTFILE=/home/you/.zsh_history
# BASH_RUN_TIMEOUT=30
# BASH_RUN_MAX_CHARS=4000

# Observability (agent defaults match these if unset)
# Requires: docker compose up -d
# SALLM_OTLP=http://localhost:4318
# SALLM_METRICS_PORT=9464
